{
  "server": {
    "host": "0.0.0.0",
    "port": 3001,
    "maxPayloadSize": "50mb"
  },
  "ffmpeg": {
    "path": "ffmpeg",
    "ffprobePath": "ffprobe",
    "hlsTime": 2,
    "hlsListSize": 6,
    "hlsDeleteThreshold": 4,
    "gopSeconds": 2,
    "threads": 2,
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
  },
  "stream": {
    "hlsRoot": "hls",
    "idleStopSeconds": 60,
    "maxRestarts": 20,
    "restartBackoffMs": 5000,
    "startupQueueDelayMs": 8000,
    "startupConcurrency": 1,
    "autoRestartCrashed": true,
    "sourceFailStopSeconds": 180,
    "blockedStopSeconds": 300
  },
  "cache": {
    "maxDiskUsageMb": 10240,
    "autoCleanupIntervalMinutes": 60,
    "deleteOldSegmentsAfterMinutes": 1440,
    "maxSegmentsPerChannel": 100
  },
  "heartbeat": {
    "intervalMs": 15000,
    "viewerTimeoutSeconds": 60
  },
  "log": {
    "level": "info",
    "maxFiles": 10,
    "maxSizeMb": 10,
    "console": true,
    "file": true,
    "memory": false
  },
  "admin": {
    "username": "admin",
    "password": "admin123",
    "sessionTimeoutMinutes": 60
  },
  "sources": {
    "importConcurrency": 3,
    "timeoutMs": 30000,
    "maxChannelsPerSource": 10000
  },
  "health": {
    "checkIntervalMinutes": 5,
    "timeoutMs": 15000,
    "concurrentChecks": 5
  }
}